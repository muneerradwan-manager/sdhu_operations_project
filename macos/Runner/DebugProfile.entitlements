<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Debug only: the Flutter tool's VM service listens on a local port. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<!-- Keep in step with Release.entitlements: everything below this line is
	     the app's own, and a capability missing from one file is a feature
	     that works in `flutter run` and fails in the shipped build. -->
	<!-- Outgoing connections: Supabase, Firebase, map tiles, images. The
	     sandbox blocks every socket without this. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Files the user picks in an open or save dialog: attachments, the PDF
	     field, "save to device", exports. Read-write because saving writes. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- The camp-gate QR scanner (mobile_scanner). -->
	<key>com.apple.security.device.camera</key>
	<true/>
	<!-- Position for check-in and for pinning places on the map (geolocator). -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- The print dialog for generated PDFs (printing). -->
	<key>com.apple.security.print</key>
	<true/>
</dict>
</plist>

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.env

# Secrets / service-account keys — never commit
firebase/*-adminsdk-*.json
**/*serviceAccount*.json
# Local tool state. `.claude/settings.json` records an allowlist built from the
# commands actually run, so a seeding command carrying a service key ends up
# written into it verbatim. Local by nature, and a place a secret can arrive
# without anyone deciding to put one there.
.claude/
.VSCodeCounter/
# Admin/service keys for local seeding. Deliberately NOT `.env`: that file is
# bundled as a Flutter asset, so anything in it ships inside the APK.
.env.seed

# Exported data. The export screen writes real people into these — names,
# emails, telephone numbers of the mission's staff — and the share sheet drops
# them wherever the person chose, which on a development machine is often the
# project folder. They are not bundled into the app (only `assets/images/` and
# `assets/fonts/pdf/` are declared), so the danger is not the APK: it is one
# `git add .` putting the staff directory into the repository's history, where
# it cannot be taken back out.
*.csv
!test/**/*.csv
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing. The keystore lives outside the repo (…/Projects/keys) and the
# passwords must never enter it: lose the key and the app can never be updated,
# leak it and anyone can publish as you.
android/key.properties
**/*.jks
**/*.keystore

# Generated by the 1447 seed: a name -> profile-id map for one live project.
# Derived state, and it carries real addresses. Re-made by make_users.py.
supabase/seeds/decisions_1447/roster.json

# Widget Preview related
.widget_preview/
